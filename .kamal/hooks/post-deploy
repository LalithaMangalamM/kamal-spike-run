#!/usr/bin/env bash
set -e

echo "=== [Post-Deploy] Running parallel Docker cleanup across all target hosts ==="

DEST=${KAMAL_DESTINATION:-production}

# Double ampersands cleanly chain commands across SSH execution without producing double semicolons
kamal server exec -d "$DEST" -- "docker container prune -f && docker images 'lalithamangalamm/kamal_spike_run' --format '{{.ID}} {{.CreatedAt}}' | sort -k2,3 -r | tail -n +2 | awk '{print \$1}' | xargs -r docker rmi -f || true && docker builder prune -f && docker image prune -f"

echo "=== Post-deploy cleanup complete on all hosts ==="
